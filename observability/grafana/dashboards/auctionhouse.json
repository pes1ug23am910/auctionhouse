{
  "id": null,
  "uid": "auctionhouse-local",
  "title": "Auctionhouse local service",
  "tags": [
    "auctionhouse",
    "local"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 4,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP request rate",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_instance_id) (rate(http_server_request_duration_seconds_count{service_name=\"auctionhouse\"}[$__rate_interval]))",
          "legendFormat": "{{service_instance_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP server error ratio",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (service_instance_id) (rate(http_server_request_duration_seconds_count{service_name=\"auctionhouse\",http_response_status_code=~\"5..\"}[$__rate_interval])) or on (service_instance_id) (0 * sum by (service_instance_id) (rate(http_server_request_duration_seconds_count{service_name=\"auctionhouse\"}[$__rate_interval])))) / clamp_min(sum by (service_instance_id) (rate(http_server_request_duration_seconds_count{service_name=\"auctionhouse\"}[$__rate_interval])), 0.001)",
          "legendFormat": "{{service_instance_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Server errors divided by observed HTTP requests. No matching error series yields zero only when the request series exists."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP p95 duration",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (service_instance_id, le) (rate(http_server_request_duration_seconds_bucket{service_name=\"auctionhouse\"}[$__rate_interval])))",
          "legendFormat": "{{service_instance_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Bid responses by outcome",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_instance_id, outcome) (rate(auctionhouse_bid_response_total{service_name=\"auctionhouse\"}[$__rate_interval]))",
          "legendFormat": "{{service_instance_id}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Transaction retries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_instance_id, isolation, sqlstate) (rate(auctionhouse_transaction_retry_total{service_name=\"auctionhouse\"}[$__rate_interval]))",
          "legendFormat": "{{service_instance_id}} {{isolation}} {{sqlstate}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Cache hit ratio",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (service_instance_id, backend) (rate(auctionhouse_cache_hit_total{service_name=\"auctionhouse\"}[$__rate_interval])) or on (service_instance_id, backend) (0 * sum by (service_instance_id, backend) (rate(auctionhouse_cache_miss_total{service_name=\"auctionhouse\"}[$__rate_interval])))) / clamp_min((sum by (service_instance_id, backend) (rate(auctionhouse_cache_hit_total{service_name=\"auctionhouse\"}[$__rate_interval])) or on (service_instance_id, backend) (0 * sum by (service_instance_id, backend) (rate(auctionhouse_cache_miss_total{service_name=\"auctionhouse\"}[$__rate_interval])))) + (sum by (service_instance_id, backend) (rate(auctionhouse_cache_miss_total{service_name=\"auctionhouse\"}[$__rate_interval])) or on (service_instance_id, backend) (0 * sum by (service_instance_id, backend) (rate(auctionhouse_cache_hit_total{service_name=\"auctionhouse\"}[$__rate_interval])))), 0.001)",
          "legendFormat": "{{service_instance_id}} {{backend}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "Hits divided by hits plus misses, including backends with only one observed counter. Absent cache telemetry remains absent."
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Pending outbox rows",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "auctionhouse_outbox_pending{service_name=\"auctionhouse\"}",
          "legendFormat": "{{service_instance_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "JVM memory used",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_instance_id, jvm_memory_type) (jvm_memory_used_bytes{service_name=\"auctionhouse\",jvm_memory_type!=\"\"})",
          "legendFormat": "{{service_instance_id}} {{jvm_memory_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "description": "OpenTelemetry runtime heap and non-heap pools only. Micrometer exports the same metric name without jvm_memory_type and is excluded to avoid duplicate totals."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Local HTTP availability probe",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "auctionhouse_probe_success",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Notification delivery results",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_instance_id, outcome) (rate(auctionhouse_notification_delivery_total{service_name=\"auctionhouse\"}[$__rate_interval]))",
          "legendFormat": "{{service_instance_id}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
